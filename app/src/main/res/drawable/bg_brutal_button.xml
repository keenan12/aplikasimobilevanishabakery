<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Aggressive Shadow (Offset by 6dp) -->
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_shadow" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- The Top Layer (The Button Surface with Thick Border) -->
    <item android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <stroke android:width="4dp" android:color="@color/brutal_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
