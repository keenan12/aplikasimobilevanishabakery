<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer (Black) -->
    <item
        android:bottom="0dp"
        android:left="6dp"
        android:right="0dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Main Layer -->
    <item
        android:bottom="6dp"
        android:left="0dp"
        android:right="6dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_red" />
            <stroke
                android:width="3dp"
                android:color="@color/black" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
