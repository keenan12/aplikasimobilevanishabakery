<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="40dp"
    android:paddingHorizontal="24dp"
    android:background="@drawable/bg_bottom_sheet_modern">

    <View
        android:layout_width="60dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@color/black" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tambah_produk"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Isi detail untuk memperbarui inventaris"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNamaProduk"
        style="@style/Widget.Vanisha.TextInputLayout.Neo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_nama_produk"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="@drawable/bg_neo_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHargaProduk"
        style="@style/Widget.Vanisha.TextInputLayout.Neo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_harga_produk"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHargaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="@drawable/bg_neo_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilStokProduk"
        style="@style/Widget.Vanisha.TextInputLayout.Neo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_stok_awal"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etStokProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="@drawable/bg_neo_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatal"
            style="@style/Widget.Vanisha.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/btn_batal"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            style="@style/Widget.Vanisha.Button.Neo"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/simpan"
            android:textColor="@color/black"
            android:background="@drawable/bg_neo_button_teal" />
    </LinearLayout>

</LinearLayout>
