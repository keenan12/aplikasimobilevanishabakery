<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Detail Mitra"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto Mitra -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="4dp"
                app:strokeColor="@color/black">
                <ImageView
                    android:id="@+id/ivMitra"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/neo_bg" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Vanisha.Card.Neo">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvNamaToko"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store Name"
                        android:textColor="@color/black"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStaff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIDAFTARKAN OLEH: -"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/black"
                        android:layout_marginTop="20dp" />

                    <!-- Status Badge -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENUNGGU"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_neo_input"
                        android:backgroundTint="@color/neo_yellow" />

                    <!-- Maps Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLihatMaps"
                        style="@style/Widget.Vanisha.Button.Neo"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="32dp"
                        android:text="LIHAT LOKASI DI PETA"
                        android:background="@drawable/bg_neo_button_teal"
                        app:icon="@drawable/ic_map"
                        app:iconGravity="textStart"
                        app:iconTint="@color/black" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Admin Actions -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="40dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.Vanisha.Button.Neo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="TOLAK"
                    android:textColor="@color/black"
                    android:background="@drawable/bg_neo_button_red"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApprove"
                    style="@style/Widget.Vanisha.Button.Neo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="SETUJUI"
                    android:background="@drawable/bg_neo_button_green"
                    android:textColor="@color/black" />

            </LinearLayout>

            <!-- Delete Action (Admin Only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Vanisha.Button.Neo"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="40dp"
                android:text="HAPUS / ARSIPKAN MITRA"
                android:textColor="@color/black"
                android:background="@drawable/bg_neo_button_red"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/black"
                app:iconGravity="textStart"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="40dp"
                android:indeterminateTint="@color/black"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
