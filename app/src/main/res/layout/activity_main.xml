<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.main.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- NEO NAVIGATION BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:background="@drawable/bg_neo_card"
        app:cardBackgroundColor="@color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- Home -->
            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <View
                    android:id="@+id/bgHome"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_nav_selection"
                    android:visibility="visible" />
                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/black" />
            </FrameLayout>

            <!-- Produk -->
            <FrameLayout
                android:id="@+id/navProduk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <View
                    android:id="@+id/bgProduk"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_nav_selection"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivNavProduk"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_bakery_bag"
                    app:tint="@color/black" />
            </FrameLayout>

            <!-- Add Button (Integrated) -->
            <FrameLayout
                android:id="@+id/navAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/neo_teal"
                    app:strokeWidth="3dp"
                    app:strokeColor="@color/black"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/ivNavAdd"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/black" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Riwayat -->
            <FrameLayout
                android:id="@+id/navRiwayat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <View
                    android:id="@+id/bgRiwayat"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_nav_selection"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivNavRiwayat"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_scroll"
                    app:tint="@color/black" />
            </FrameLayout>

            <!-- Profil -->
            <FrameLayout
                android:id="@+id/navProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <View
                    android:id="@+id/bgProfil"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_nav_selection"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivNavProfil"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/black" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>